# Documentation only: export these variables in your shell; tooling does not load .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=bsc_admissions
PGUSER=bsc_migrator
# Keep the password in an untracked .pgpass (chmod 600) or secret manager.
# Production TCP connections must also set PGSSLMODE=verify-full and PGSSLROOTCERT.
