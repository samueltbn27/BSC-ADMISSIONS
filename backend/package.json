{
  "name": "bsc-admissions-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API full-stack BSC Admissions (Express + TypeScript + PostgreSQL existing)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo:seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "hash-wasm": "4.12.0",
    "helmet": "8.0.0",
    "jpeg-js": "^0.4.4",
    "multer": "2.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.13.1",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "^24.19.2",
    "@types/pg": "8.11.10",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "6.0.2",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "4.1.12"
  }
}
