{
  "name": "bsc-admissions-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API full-stack BSC Admissions (Express + TypeScript + PostgreSQL existing)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "hash-wasm": "4.12.0",
    "helmet": "8.0.0",
    "multer": "^2.0.2",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.27.4"
  }
}
