# Backend BSC Admissions. Salin ke .env (tidak di-commit) dan isi kredensial.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Kredensial database (role dari database/bootstrap/privileges.sql)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=bsc_admissions
PGUSER_RUNTIME=bsc_app
PGPASSWORD_RUNTIME=
PGUSER_AUTH=bsc_auth_login
PGPASSWORD_AUTH=

# Keamanan sesi
SESSION_COOKIE_NAME=bsc_session
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# Upload dokumen (di luar direktori publik)
UPLOAD_DIR=../storage/uploads
UPLOAD_MAX_BYTES=5242880

# Origin yang diizinkan (CSRF, tanpa cross-origin API). Untuk dev Vite: http://localhost:5173
ALLOWED_ORIGIN=http://localhost:4000

# Rate limit development
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# Sajikan build frontend statis dari backend (satu origin, tanpa proxy).
# Kosongkan jika hanya memakai Vite dev server terpisah.
FRONTEND_DIST=../frontend/dist
